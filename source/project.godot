; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="造梦西游八荒湮隳"
config/description="被师徒一行人打败的各大魔头又受到神秘力量的侵蚀重返三界，浩劫之际，天崩地裂，能否再次斩妖除魔，歼灭罪魁祸首……"
run/main_scene="res://Scene/other_scene/load_scene.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=150
run/low_processor_mode_sleep_usec=16000
boot_splash/bg_color=Color(0.141176, 0.141176, 0.141176, 0)
boot_splash/image="res://Art/main_game/bhpic.png"
config/icon="res://Art/main_game/bhpic.png"
config/windows_native_icon="res://Art/main_game/bhico.ico"

[autoload]

BaseHit="*res://base_hit.gd"
RoleProp="*res://Script/base/base_role_properies.gd"
PlayerData="*res://Script/memory_class/player_data.gd"
MemoryClass="*res://Script/memory_class/memory_class.gd"
MainSet="*res://Script/memory_class/main_set.gd"
AE="*res://all_equipment.gd"
MLdl="*res://Script/ldl/main_ldl.gd"
PaSkill="*res://passive_skills.gd"
MainMusic="*res://main_music.gd"
Signals="*res://signals.gd"
Global="*res://global.gd"
LocalCoop="*res://Script/coop/local_coop.gd"
MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1600
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0
mouse_cursor/custom_image="res://Art/main_game/sbgb.png"
window/size/initial_width=1600
window/size/initial_height=1000
#display/window/size/width=1280
(duplicate,keptforcompatibility)#display/window/size/height=720
(duplicate,keptforcompatibility)#display/window/size/mode="windowed"
(duplicate,keptforcompatibility)display/window/dpi/allow_hidpi=true

[editor]

movie_writer/disable_vsync=true

[editor_overrides]

text_editor/behavior/indent/type=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[global_group]

Player=""
Monster=""

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=true
port_override=6551

[importer_defaults]

animation_library={
&"animation/fps": 60.0
}

