theme_override_constants/outline_size = 2
theme_override_constants/shadow_outline_size = 6
theme_override_fonts/font = ExtResource("4")
theme_override_font_sizes/font_size = 18
text = "2.点击左侧Boss列表可将Boss添加到召唤列表内，召唤太多会很卡！不可重复添加，通关指定关卡可以解锁对应地图Boss。(截教天境暂不支持)"
autowrap_mode = 1

[node name="Text_12" type="Label" parent="BG/ScrollContainer/VBoxContainer" unique_id=1498466509]
layout_mode = 2
