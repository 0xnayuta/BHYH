text = "1.测试阶段，可能有一些小Bug，仅供娱乐，目的不是用来练过关的，只是娱乐！"
autowrap_mode = 1

[node name="Text_11" type="Label" parent="BG/ScrollContainer/VBoxContainer" unique_id=1670470066]
layout_mode = 2
size_flags_vertical = 8
theme_override_colors/font_color = Color(0, 0, 0, 1)
