[node name="_1" type="Label" parent="BG/ColorRect/ScrollContainer/VBoxContainer" unique_id=846664352]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_fonts/font = ExtResource("3")
theme_override_font_sizes/font_size = 20
text = "1.只有制作书可以参与打造。"
vertical_alignment = 1
autowrap_mode = 1

[node name="_2" type="Label" parent="BG/ColorRect/ScrollContainer/VBoxContainer" unique_id=1961592301]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_fonts/font = ExtResource("3")
theme_override_font_sizes/font_size = 20
text = "2.打造需要消耗一定量的材料和灵魂，材料种类和数量会因制作书的种类不同而不同。"
vertical_alignment = 1
autowrap_mode = 1

[node name="_3" type="Label" parent="BG/ColorRect/ScrollContainer/VBoxContainer" unique_id=121208265]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_fonts/font = ExtResource("3")
theme_override_font_sizes/font_size = 20
text = "3.打造时，可以放入宝珠来提升属性，至多可以放入3颗，不同的宝珠可以额外提升最终装备不同的属性。"
vertical_alignment = 1
autowrap_mode = 1

[node name="_4" type="Label" parent="BG/ColorRect/ScrollContainer/VBoxContainer" unique_id=1913110575]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_fonts/font = ExtResource("3")
theme_override_font_sizes/font_size = 20
text = "4.材料充足时，材料位置显示绿字，否则显示红字。"
vertical_alignment = 1
autowrap_mode = 1

[node name="_5" type="Label" parent="BG/ColorRect/ScrollContainer/VBoxContainer" unique_id=1242342030]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_fonts/font = ExtResource("3")
theme_override_font_sizes/font_size = 20
text = "5.不放宝珠则打造出的装备默认为基础属性。"
vertical_alignment = 1
autowrap_mode = 1

[node name="_6" type="Label" parent="BG/ColorRect/ScrollContainer/VBoxContainer" unique_id=240538419]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_fonts/font = ExtResource("3")
theme_override_font_sizes/font_size = 20
text = "6.放入制作书后可在生成物处查看生成装备，字体颜色和品质相同。"
vertical_alignment = 1
autowrap_mode = 1

[node name="_7" type="Label" parent="BG/ColorRect/ScrollContainer/VBoxContainer" unique_id=607188823]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_fonts/font = ExtResource("3")
theme_override_font_sizes/font_size = 20
text = "7.目前宝珠只有火灵珠，水灵珠，雷灵珠，土灵珠，风灵珠，可从神秘店铺购买碎片或成品。"
vertical_alignment = 1
autowrap_mode = 1

