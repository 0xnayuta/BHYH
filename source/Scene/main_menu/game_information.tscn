[node name="_1" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=529165560]
layout_mode = 2
size_flags_vertical = 3
text = "1.游戏绝大多数元素与原版相同，部分功能为新开发。"

[node name="_2" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=894711195]
layout_mode = 2
text = "2.玩家属性和怪物属性新增命中，韧性，暴免，吸血，幸运，破甲，破魔。"
vertical_alignment = 1

[node name="_3" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=835489167]
layout_mode = 2
text = "3.玩家，怪物减伤算法改变。"
vertical_alignment = 1

[node name="_4" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=1201122717]
layout_mode = 2
text = "4.装备属性为随机值，可以通过强化提升装备属性。"
vertical_alignment = 1

[node name="_5" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=2072002218]
layout_mode = 2
text = "5.回血时，超过生命上限的部分将不会显示。"
vertical_alignment = 1

[node name="_6" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=2099390264]
layout_mode = 2
text = "6.根据造成伤害的类型，伤害显示数字会呈现不同的颜色和样式。"
vertical_alignment = 1

[node name="_7" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=2090733366]
layout_mode = 2
text = "7.怪物行动逻辑发生改变，部分怪物拥有新的技能效果。"
vertical_alignment = 1

[node name="_8" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=1001648395]
layout_mode = 2
text = "8.新增加了装备幻化功能，快去试试吧！"
vertical_alignment = 1

[node name="_9" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=42579344]
layout_mode = 2
text = "9.背包的每一页可以看作一个独立的背包，批量出售时，每页内物品不会变更到其他的装备页，
请注意！！"
vertical_alignment = 1

[node name="_10" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=963822224]
layout_mode = 2
text = "10.背包新增消耗品分类，类似于一些buff，可用道具，会被分到该类。"
vertical_alignment = 1

[node name="_11" type="Label" parent="bg/ColorRect/VBoxContainer/Control/yxgg/ScrollContainer/HBoxContainer" unique_id=150920582]
layout_mode = 2
text = "11.装备强化不再存在成功率，装备每级强化需要一定数量的强化石和灵魂，达到要求即可强化成功，当前最高强化至7级。"
vertical_alignment = 1
autowrap_mode = 1

